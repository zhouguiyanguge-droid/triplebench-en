---
import BaseLayout from "../layouts/BaseLayout.astro";
import benchmarks from "../data/seed-benchmarks.json";

const ranked = benchmarks.map((item) => ({
  ...item,
  average: Math.round((item.coding + item.research + item.workflow + item.costClarity) / 4)
}));
---

<BaseLayout
  title="TripleBench - AI tool benchmarks that show the working path"
  description="TripleBench compares AI coding and research tools with practical workflows, transparent prompts, and repeatable scoring."
>
  <main>
    <section class="hero">
      <div>
        <p class="eyebrow">AI tool benchmarks, built for operators</p>
        <h1>TripleBench</h1>
        <p class="lede">
          A practical comparison journal for Codex, Claude Code, Gemini CLI, and the next wave of AI work tools. Ada tests the same task across three tools and publishes the workflow, friction, and score.
        </p>
        <div class="hero-actions">
          <a class="button" href="/reports/codex-vs-claude-vs-gemini/">Read the first report</a>
          <a class="button secondary" href="/methodology/">View methodology</a>
        </div>
      </div>
      <aside class="score-panel" aria-label="Seed benchmark score chart">
        <header>
          <strong>Seed benchmark</strong>
          <span>Average score</span>
        </header>
        <div class="bar-list">
          {
            ranked.map((item, index) => (
              <div class="bar-row">
                <div class="bar-meta">
                  <span>{item.tool}</span>
                  <span>{item.average}</span>
                </div>
                <div class="track">
                  <div
                    class="fill"
                    style={`--score: ${item.average}%; --bar-color: ${index === 0 ? "var(--accent)" : index === 1 ? "var(--accent-2)" : "var(--accent-3)"}`}
                  />
                </div>
              </div>
            ))
          }
        </div>
      </aside>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>Latest comparison</h2>
        <p>The first article is a launch scaffold based on a defined rubric. Replace seed scores with repeated live test evidence before marking it as final.</p>
      </div>
      <div class="grid">
        {
          ranked.map((item) => (
            <article class="card">
              <h3>{item.tool}</h3>
              <p>{item.bestFor}</p>
              <p><strong>{item.average}/100</strong> seed average across coding, research, workflow, and cost clarity.</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>What gets measured</h2>
        <p>TripleBench favors repeatable work over vibes: same prompt, same acceptance criteria, separate notes for tool limits and human setup.</p>
      </div>
      <table class="metric-table">
        <thead>
          <tr>
            <th>Metric</th>
            <th>Question</th>
            <th>Weight</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Coding execution</td>
            <td>Can the tool make correct local changes and verify them?</td>
            <td>35%</td>
          </tr>
          <tr>
            <td>Research quality</td>
            <td>Does it find current, relevant, source-backed information?</td>
            <td>20%</td>
          </tr>
          <tr>
            <td>Workflow continuity</td>
            <td>Can it preserve state, recover from blockers, and hand off cleanly?</td>
            <td>30%</td>
          </tr>
          <tr>
            <td>Cost clarity</td>
            <td>Can an operator predict the subscription, token, or usage cost?</td>
            <td>15%</td>
          </tr>
        </tbody>
      </table>
    </section>
  </main>
</BaseLayout>

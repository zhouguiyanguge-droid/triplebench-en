---
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = [
  {
    href: "/reports/run-002-dotenv-bom/",
    tag: "Benchmark · run-002",
    accent: "#16a34a",
    title: "All three AIs said \u201cfixed\u201d \u2014 I'd only merge one without looking",
    desc: "An invisible character silently breaks .env configs. All three pass the hidden gate on a real python-dotenv bug \u2014 but exit hygiene differs a lot. Full diff evidence.",
    date: "2026-06",
  },
  {
    href: "/reports/digital-human-pipeline/",
    tag: "Open question",
    accent: "#9333ea",
    title: "The perfect tool stack for a fully-automated digital-human pipeline?",
    desc: "6 stages, the 2026 candidates for each, our leanings — and 4 questions for people who've actually shipped.",
    date: "2026-06",
  },
  {
    href: "/reports/ai-video-pipeline/",
    tag: "Open build log",
    accent: "#dc2626",
    title: "We built an AI film pipeline that wrote 437 scripts and shipped 0 films",
    desc: "Codex + Claude Code, stuck for 20 days. How an agent over-engineered itself into paralysis — and what we're asking for help on.",
    date: "2026-06",
  },
  {
    href: "/reports/codex-vs-claude-vs-gemini/",
    tag: "Benchmark · run-001",
    accent: "#ea580c",
    title: "Same bug, three agents, one held-out test",
    desc: "Codex, Claude Code and Gemini CLI fix the same real pendulum bug under an identical prompt and a hidden gate. All pass — the difference is in the details.",
    date: "2026-05",
  },
];
---

<BaseLayout
  title="All reports - TripleBench"
  description="Every TripleBench report and open build log: head-to-head AI tool benchmarks and real-world build logs, all with public evidence."
>
  <main class="article tb-index">
    <p class="eyebrow tb-badge">All reports</p>
    <h1>Everything we've published</h1>
    <p class="lede">
      Head-to-head AI tool benchmarks and open build logs — each with the exact prompt, the evidence, and an honest verdict. Newest first.
    </p>

    <div class="tb-list">
      {posts.map((p) => (
        <a class="tb-row" href={p.href} style={`--accent:${p.accent}`}>
          <div class="tb-row-top">
            <span class="tb-chip">{p.tag}</span>
            <span class="tb-date">{p.date}</span>
          </div>
          <h2>{p.title}</h2>
          <p>{p.desc}</p>
          <span class="tb-go">Read →</span>
        </a>
      ))}
    </div>

    <p class="tb-foot">New reports land here as we run them. Disagree with a verdict? Open an issue on GitHub.</p>
  </main>

  <style>
    .tb-badge { display:inline-block; background:linear-gradient(90deg,#ea580c,#f59e0b); color:#fff; padding:.3rem .7rem; border-radius:999px; font-weight:700; }
    .tb-list { display:flex; flex-direction:column; gap:1rem; margin:2rem 0; }
    .tb-row {
      display:block; text-decoration:none; color:inherit;
      border:1px solid #e5e7eb; border-left:5px solid var(--accent); border-radius:14px;
      padding:1.2rem 1.4rem; background:#fff; box-shadow:0 4px 18px rgba(0,0,0,.05);
      transition:transform .15s ease, box-shadow .15s ease;
    }
    .tb-row:hover { transform:translateY(-3px); box-shadow:0 12px 30px rgba(0,0,0,.1); }
    .tb-row-top { display:flex; justify-content:space-between; align-items:center; margin-bottom:.5rem; }
    .tb-chip { font-size:.72rem; font-weight:800; color:#fff; background:var(--accent); padding:.18rem .6rem; border-radius:999px; }
    .tb-date { font-size:.82rem; color:#a1a1aa; }
    .tb-row h2 { font-size:1.3rem !important; margin:.2rem 0 .4rem; line-height:1.35; }
    .tb-row p { color:#52525b; margin:0; font-size:.95rem; line-height:1.6; }
    .tb-go { display:inline-block; margin-top:.7rem; color:var(--accent); font-weight:700; font-size:.9rem; }
    .tb-foot { margin-top:1.5rem; font-size:.82rem; color:#a1a1aa; }
    @media (prefers-color-scheme: dark) {
      .tb-row { background:#18181b; border-color:#27272a; }
      .tb-row p { color:#a1a1aa; }
    }
  </style>
</BaseLayout>
